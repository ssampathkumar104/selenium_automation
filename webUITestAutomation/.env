# Django Settings
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True

# Database Settings
DB_NAME=iDeliver
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# AWS S3 Configuration
#AWS_ACCESS_KEY_ID=your-aws-access-key-here
#AWS_ACCESS_SECRET_KEY=your-aws-secret-key-here
# AWS_STORAGE_BUCKET_NAME=ipc-bucket
AWS_STORAGE_BUCKET_NAME=ipc-bucket
AWS_S3_REGION_NAME=us-east-1

# Legacy AWS Config (for backward compatibility)
#aws.access-key=your-aws-access-key-here
#aws.secret-key=your-aws-secret-key-here
# aws.s3.bucket-name=ipc-bucket
aws.s3.bucket-name=ipc-bucket
aws.region=us-east-1

# Below S3 Feature Flags are Dummy and unnecessary for SpringBoot App
TESTREPORTING_FF_USE_S3_FOR_LOGS=true
TESTREPORTING_FF_USE_S3_FOR_ARTIFACTS=true
TESTREPORTING_FF_USE_S3_FOR_SCREENSHOTS=true
TESTREPORTING_FF_FALLBACK_TO_DB=false

# S3 Feature Flags
TESTREPORTING_FF_STREAM_LARGE_FILES=true

# API Settings
API_BASE_URL=http://localhost:9515
API_TIMEOUT=30 