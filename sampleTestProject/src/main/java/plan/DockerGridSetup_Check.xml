<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<suite name="DockerGridSetup_Check">

	<parameter name="BASE_URL" 	value="https://your-environment-url.example.com" />
	<parameter name="USER_NAME" value="automation.user@example.com" />
	<parameter name="PASSWORD" value="your-password-here" />
	
	<parameter name="browserName" value="chrome" />
	<parameter name="generateDocument" value="true" />
	<parameter name="implicitlyWaitTime" value="15" />
	<parameter name="pageLoadTimeout" value="120" />
	<parameter name="scriptTimeout" value="30" />
	<parameter name="remote" value="true" />
	<parameter name="recording" value="false" />
    <parameter name="remoteURL" value="http://your-selenium-grid-host:4444/wd/hub" />
	
     <test name="DockerSetupTest">
        <classes>
            <class name="scripts.TCLN_DockerWithBrowserFactory" />
        </classes>
    </test> 
    
    <test name="LNPOTest">
        <classes>
            <class name="scripts.TCLN_LNCreateApprovePurchaseOrder" />
        </classes>
    </test>


</suite>
