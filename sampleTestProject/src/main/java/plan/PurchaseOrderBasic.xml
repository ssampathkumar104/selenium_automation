<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE suite SYSTEM 'https://testng.org/testng-1.0.dtd'>
<suite name="PurchaseOrderBasic" parallel ="tests">

	<parameter name="BASE_URL" 	value="https://your-environment-url.example.com" />
	<parameter name="USER_NAME" value="test.user@example.com" />
	<parameter name="PASSWORD" value="your-password-here" />
	<parameter name="dataFolder" value="test" />
	
	<parameter name="generateDocument" value="false" />
	<parameter name="Generate_TestResultsDoc" value="yes" />	 

	<parameter name="browserName" value="chrome" />
	<parameter name="implicitlyWaitTime" value="10" />
